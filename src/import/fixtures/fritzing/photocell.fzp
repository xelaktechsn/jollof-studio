<?xml version="1.0" encoding="UTF-8"?>
<!-- Pièce écrite à la main pour les tests de Jollof Studio (format .fzp publié par Fritzing). -->
<module fritzingVersion="0.9.3b" moduleId="JollofTestPhotocellModule">
  <version>1</version>
  <author>Jollof Studio (fixture)</author>
  <title>Photocell Light Sensor</title>
  <label>LDR</label>
  <description>&lt;p&gt;Light sensor module with an &lt;b&gt;analog&lt;/b&gt; output and a comparator output.&lt;/p&gt;</description>
  <tags><tag>sensor</tag><tag>light</tag></tags>
  <properties>
    <property name="family">Light Sensor</property>
    <property name="supply">3.3-5V</property>
  </properties>
  <views>
    <iconView><layers image="icon/photocell_icon.svg"><layer layerId="icon"/></layers></iconView>
    <breadboardView><layers image="breadboard/photocell_bb.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <schematicView><layers image="schematic/photocell_sch.svg"><layer layerId="schematic"/></layers></schematicView>
  </views>
  <connectors>
    <connector id="connector0" name="VCC" type="male">
      <description>Supply voltage</description>
      <views><breadboardView><p layer="breadboard" svgId="connector0pin" terminalId="connector0terminal"/></breadboardView></views>
    </connector>
    <connector id="connector1" name="GND" type="male">
      <description>Ground</description>
      <views><breadboardView><p layer="breadboard" svgId="connector1pin" terminalId="connector1terminal"/></breadboardView></views>
    </connector>
    <connector id="connector2" name="DO" type="male">
      <description>Digital output (comparator)</description>
      <views><breadboardView><p layer="breadboard" svgId="connector2pin" terminalId="connector2terminal"/></breadboardView></views>
    </connector>
    <connector id="connector3" name="AO" type="male">
      <description>Analog output</description>
      <views><breadboardView><p layer="breadboard" svgId="connector3pin" terminalId="connector3terminal"/></breadboardView></views>
    </connector>
  </connectors>
</module>
