{
 "id": "net60-vlan-routage-inter-vlan",
 "series": "reseau",
 "level": "pro",
 "minutes": 50,
 "title": {
  "fr": "Segmentation en VLAN avec routage inter-VLAN",
  "en": "VLAN segmentation with inter-VLAN routing"
 },
 "summary": {
  "fr": "Un bâtiment avec trois services sur un même switch : administration, atelier, invités. On les sépare en VLAN 802.1Q, on fait passer les VLAN par un trunk jusqu’au switch de cœur de niveau 3, qui route entre eux et relaie le DHCP vers le serveur. Puis on vérifie au ping et au traceroute, et on fixe la racine du Spanning Tree.",
  "en": "One building with three departments on the same switch: administration, workshop, guests. We split them into 802.1Q VLANs, carry the VLANs over a trunk to the layer 3 core switch, which routes between them and relays DHCP to the server. Then we check with ping and traceroute, and set the Spanning Tree root."
 },
 "objectives": [
  {
   "fr": "Placer des ports d’accès dans des VLAN",
   "en": "Put access ports in VLANs"
  },
  {
   "fr": "Configurer un trunk 802.1Q et ses VLAN autorisés",
   "en": "Configure an 802.1Q trunk and its allowed VLANs"
  },
  {
   "fr": "Créer des interfaces VLAN (SVI) et un relais DHCP",
   "en": "Create VLAN interfaces (SVIs) and a DHCP relay"
  },
  {
   "fr": "Lire un traceroute",
   "en": "Read a traceroute"
  },
  {
   "fr": "Choisir la racine du Spanning Tree",
   "en": "Choose the Spanning Tree root"
  }
 ],
 "takeaways": [
  {
   "fr": "Un VLAN est un réseau de diffusion à part : deux postes de VLAN différents ne se voient pas sans routeur.",
   "en": "A VLAN is a separate broadcast network: two computers in different VLANs do not see each other without a router."
  },
  {
   "fr": "Port d’accès : un VLAN, sans étiquette. Trunk : plusieurs VLAN étiquetés 802.1Q, et un VLAN natif sans étiquette, le même aux deux bouts.",
   "en": "Access port: one VLAN, untagged. Trunk: several 802.1Q-tagged VLANs, and one untagged native VLAN, the same at both ends."
  },
  {
   "fr": "La passerelle d’un VLAN est son interface VLAN (SVI) sur le switch de niveau 3 ; le relais DHCP (ip helper) envoie les demandes au serveur, qui choisit l’étendue d’après l’adresse du relais (giaddr).",
   "en": "A VLAN’s gateway is its VLAN interface (SVI) on the layer 3 switch; the DHCP relay (ip helper) sends requests to the server, which picks the scope from the relay address (giaddr)."
  },
  {
   "fr": "Le Spanning Tree élit la racine par la priorité la plus basse : on la fixe sur le cœur.",
   "en": "Spanning Tree elects the root by lowest priority: set it on the core."
  }
 ],
