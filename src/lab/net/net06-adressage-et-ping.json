{
 "id": "net06-adressage-et-ping",
 "series": "cablage",
 "level": "college",
 "minutes": 25,
 "title": {
  "fr": "Adresses IP et ping",
  "en": "IP addresses and ping"
 },
 "summary": {
  "fr": "Une petite salle sans box : chaque poste reçoit une adresse fixe. Une adresse en double, un PC sans adresse, une imprimante dans un autre réseau : on corrige, puis le ping le prouve.",
  "en": "A small room without a box: each computer gets a fixed address. A duplicate address, a PC without an address, a printer in another network: fix them, then the ping proves it."
 },
 "objectives": [
  {
   "fr": "Lire une adresse IPv4 et son masque",
   "en": "Read an IPv4 address and its mask"
  },
  {
   "fr": "Donner à chaque poste une adresse unique dans le même réseau",
   "en": "Give each computer a unique address in the same network"
  },
  {
   "fr": "Vérifier avec un ping",
   "en": "Check with a ping"
  }
 ],
 "takeaways": [
  {
   "fr": "Masque 255.255.255.0 (/24) : les trois premiers nombres désignent le réseau, le dernier le poste.",
   "en": "Mask 255.255.255.0 (/24): the first three numbers are the network, the last one the computer."
  },
  {
   "fr": "Deux postes ne peuvent pas avoir la même adresse (J1208).",
   "en": "Two computers cannot have the same address (J1208)."
  },
  {
   "fr": "Pour se parler sans routeur, deux postes doivent être dans le même réseau.",
   "en": "To talk without a router, two computers must be in the same network."
  }
 ],
