 "steps": [
  {
   "title": {
    "fr": "L’onglet Problèmes",
    "en": "The Problems tab"
   },
   "text": {
    "fr": "Ouvrez l’onglet **Problèmes** (en bas de l’écran) : chaque ligne donne un code **J12xx**, l’équipement ou le câble en cause et une explication. Cliquez sur une ligne pour voir l’élément dans le plan. Réparez dans l’ordre des étapes : du câble vers les adresses.",
    "en": "Open the **Problems** tab (at the bottom of the screen): each line gives a **J12xx** code, the device or cable involved and an explanation. Click a line to see the item on the plan. Repair in the order of the steps: from the cable up to the addresses."
   },
   "check": {
    "type": "info"
   }
  },
  {
   "title": {
    "fr": "La boucle",
    "en": "The loop"
   },
   "text": {
    "fr": "**J1206** : deux câbles relient SW1 et SW2. Sans Spanning Tree (switchs non administrables), chaque diffusion tourne sans fin entre eux et sature le réseau. Retirez un des deux câbles (choisissez-le, puis Suppr).",
    "en": "**J1206**: two cables connect SW1 and SW2. Without Spanning Tree (unmanaged switches), every broadcast loops forever between them and saturates the network. Remove one of the two cables (select it, then Delete)."
   },
   "check": {
    "type": "net-ok",
    "codes": [
     "J1206"
    ]
   }
  },
  {
   "title": {
    "fr": "Le câble de PC3",
    "en": "PC3’s cable"
   },
   "text": {
    "fr": "**J1213** : une fiche du câble de PC3 n’est pas sertie. Sertissez-la en T568B.",
    "en": "**J1213**: a plug of PC3’s cable is not crimped. Crimp it in T568B."
   },
   "spot": [
    "#tab-nprop",
    "[data-nt=\"crimpB\"]"
   ],
   "check": {
    "type": "net-ok",
    "codes": [
     "J1213",
     "J1201"
    ]
   }
  },
  {
   "title": {
    "fr": "L’adresse en double",
    "en": "The duplicate address"
   },
   "text": {
    "fr": "**J1208** : PC1 a la même adresse fixe que l’imprimante. Passez PC1 en **DHCP** : la box lui donnera une adresse libre.",
    "en": "**J1208**: PC1 has the same fixed address as the printer. Switch PC1 to **DHCP**: the box will give it a free address."
   },
   "check": {
    "type": "net-ok",
    "codes": [
     "J1208"
    ]
   }
  },
  {
   "title": {
    "fr": "La passerelle de PC2",
    "en": "PC2’s gateway"
   },
   "text": {
    "fr": "**J1210** : la passerelle de PC2, `192.168.2.1`, n’est pas dans son réseau `192.168.1.0/24`. La passerelle, c’est la box : `192.168.1.1`.",
    "en": "**J1210**: PC2’s gateway, `192.168.2.1`, is not in its `192.168.1.0/24` network. The gateway is the box: `192.168.1.1`."
   },
   "check": {
    "type": "net-ok",
    "codes": [
     "J1210",
     "J1209"
    ]
   }
  },
  {
   "title": {
    "fr": "Plus aucune erreur",
    "en": "No error left"
   },
   "text": {
    "fr": "L’onglet Problèmes ne doit plus montrer d’erreur.",
    "en": "The Problems tab must no longer show any error."
   },
   "check": {
    "type": "net-ok"
   }
  },
  {
   "title": {
    "fr": "Le ping vers la box",
    "en": "Ping the box"
   },
   "text": {
    "fr": "Faites un ping de chaque PC vers la box.",
    "en": "Ping the box from each PC."
   },
   "spot": [
    ".ntTools [data-tool=\"ping\"]"
   ],
   "check": {
    "type": "net-ping",
    "from": "pc",
    "to": "BOX1"
   }
  },
  {
   "title": {
    "fr": "Le ping vers l’imprimante",
    "en": "Ping the printer"
   },
   "text": {
    "fr": "Et vers l’imprimante, qui est sur l’autre switch.",
    "en": "And the printer, which is on the other switch."
   },
   "check": {
    "type": "net-ping",
    "from": "pc",
    "to": "IMP1"
   }
  },
  {
   "title": {
    "fr": "Pourquoi tout tombait",
    "en": "Why everything was down"
   },
   "text": {
    "fr": "Avec la boucle, même les postes bien réglés ne pouvaient rien faire. Pourquoi ?",
    "en": "With the loop, even well-configured computers could do nothing. Why?"
   },
   "check": {
    "type": "quiz",
    "options": [
     {
      "fr": "Les trames de diffusion tournent sans fin entre les deux switchs et occupent tout le réseau",
      "en": "Broadcast frames loop forever between the two switches and fill the whole network"
     },
     {
      "fr": "Le deuxième câble coupe le courant des switchs",
      "en": "The second cable cuts the switches’ power"
     },
     {
      "fr": "Deux câbles entre switchs doublent les adresses IP",
      "en": "Two cables between switches duplicate the IP addresses"
     }
    ],
    "answer": 0
   }
  }
 ]
}
