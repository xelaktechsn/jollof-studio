{
 "id": "net08-trouver-la-panne",
 "series": "cablage",
 "level": "pro",
 "minutes": 35,
 "title": {
  "fr": "Trouver la panne : un réseau à réparer",
  "en": "Find the fault: a network to repair"
 },
 "summary": {
  "fr": "Plus rien ne marche dans l’atelier. Quatre pannes s’additionnent : une boucle entre deux switchs, une fiche non sertie, une adresse en double, une passerelle fausse. L’onglet Problèmes donne les codes J12xx ; à vous de réparer, une panne à la fois.",
  "en": "Nothing works in the workshop any more. Four faults add up: a loop between two switches, an uncrimped plug, a duplicate address, a wrong gateway. The Problems tab gives the J12xx codes; it is up to you to repair, one fault at a time."
 },
 "objectives": [
  {
   "fr": "Lire les codes du vérificateur du réseau (J12xx)",
   "en": "Read the network checker’s codes (J12xx)"
  },
  {
   "fr": "Réparer une boucle, un câble, un adressage",
   "en": "Repair a loop, a cable, an addressing mistake"
  },
  {
   "fr": "Valider la réparation par le ping",
   "en": "Confirm the repair with a ping"
  }
 ],
 "takeaways": [
  {
   "fr": "Une boucle entre switchs sans Spanning Tree sature tout le réseau : les autres pannes ne se voient même plus.",
   "en": "A loop between switches without Spanning Tree saturates the whole network: the other faults cannot even be seen."
  },
  {
   "fr": "Méthode : du bas vers le haut, câbles et liens d’abord, adresses ensuite, ping pour finir.",
   "en": "Method: bottom up, cables and links first, then addresses, ping to finish."
  },
  {
   "fr": "Passerelle : une adresse du même réseau que le poste, celle de la box.",
   "en": "Gateway: an address in the same network as the computer, the box’s."
  }
 ],
