 "steps": [
  {
   "title": {
    "fr": "Le DHCP",
    "en": "DHCP"
   },
   "text": {
    "fr": "Un poste qui démarre n’a pas d’adresse. Il crie à tout le réseau (**DISCOVER**, en diffusion) ; le serveur DHCP, ici la box, lui propose une adresse (**OFFER**) ; le poste la demande (**REQUEST**) ; le serveur confirme (**ACK**). Avec l’adresse viennent le masque, la **passerelle** (la box, pour sortir vers Internet) et le serveur DNS.",
    "en": "A computer that boots has no address. It shouts to the whole network (**DISCOVER**, broadcast); the DHCP server, the box here, offers an address (**OFFER**); the computer asks for it (**REQUEST**); the server confirms (**ACK**). With the address come the mask, the **gateway** (the box, to get out to the Internet) and the DNS server."
   },
   "check": {
    "type": "info"
   }
  },
  {
   "title": {
    "fr": "Des adresses étranges",
    "en": "Strange addresses"
   },
   "text": {
    "fr": "Choisissez chaque PC et lisez son adresse dans l’inspecteur. Certains ont une adresse en `192.168.1.x`, d’autres en `192.168.0.x`. Pourquoi ?",
    "en": "Select each PC and read its address in the inspector. Some have a `192.168.1.x` address, others `192.168.0.x`. Why?"
   },
   "check": {
    "type": "quiz",
    "options": [
     {
      "fr": "Deux serveurs DHCP répondent : BOX1 et la vieille BOX2 ; chaque poste prend la première offre reçue",
      "en": "Two DHCP servers answer: BOX1 and the old BOX2; each computer takes the first offer it gets"
     },
     {
      "fr": "Les câbles de ces postes sont défectueux",
      "en": "The cables of these computers are faulty"
     },
     {
      "fr": "Ces postes ont une adresse fixe",
      "en": "These computers have a fixed address"
     }
    ],
    "answer": 0
   }
  },
  {
   "title": {
    "fr": "Un seul serveur",
    "en": "A single server"
   },
   "text": {
    "fr": "Choisissez **BOX2** et désactivez son serveur DHCP (onglet **Réseau** de l’inspecteur), ou débranchez-la. L’onglet Problèmes ne doit plus signaler deux serveurs DHCP (J1207).",
    "en": "Select **BOX2** and turn off its DHCP server (**Network** tab of the inspector), or unplug it. The Problems tab must no longer report two DHCP servers (J1207)."
   },
   "spot": [
    ".ntDev[data-id=\"box2\"]",
    "#tab-nprop"
   ],
   "check": {
    "type": "net-ok",
    "codes": [
     "J1207"
    ]
   }
  },
  {
   "title": {
    "fr": "Les baux",
    "en": "The leases"
   },
   "text": {
    "fr": "Chaque PC redemande une adresse : cette fois, toutes viennent de **BOX1**, dans sa plage 192.168.1.100 à 192.168.1.199.",
    "en": "Each PC asks for an address again: this time they all come from **BOX1**, in its range 192.168.1.100 to 192.168.1.199."
   },
   "check": {
    "type": "net-dhcp",
    "of": "pc",
    "server": "BOX1"
   }
  },
  {
   "title": {
    "fr": "Le ping vers la passerelle",
    "en": "Ping the gateway"
   },
   "text": {
    "fr": "Faites un ping de chaque PC vers la box (leur passerelle).",
    "en": "Ping the box (their gateway) from each PC."
   },
   "spot": [
    ".ntTools [data-tool=\"ping\"]"
   ],
   "check": {
    "type": "net-ping",
    "from": "pc",
    "to": "BOX1"
   }
  },
  {
   "title": {
    "fr": "La plage",
    "en": "The range"
   },
   "text": {
    "fr": "BOX1 distribue les adresses de `.100` à `.199`. Combien de postes peut-elle servir en même temps ?",
    "en": "BOX1 hands out addresses from `.100` to `.199`. How many computers can it serve at once?"
   },
   "hint": {
    "fr": "De 100 à 199 inclus : 199 − 100 + 1.",
    "en": "From 100 to 199 inclusive: 199 − 100 + 1."
   },
   "check": {
    "type": "quiz",
    "options": [
     {
      "fr": "99",
      "en": "99"
     },
     {
      "fr": "100",
      "en": "100"
     },
     {
      "fr": "254",
      "en": "254"
     }
    ],
    "answer": 1
   }
  }
 ]
}
