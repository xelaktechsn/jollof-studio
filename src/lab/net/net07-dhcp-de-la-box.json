{
 "id": "net07-dhcp-de-la-box",
 "series": "cablage",
 "level": "lycee",
 "minutes": 25,
 "title": {
  "fr": "Le DHCP de la box, et le piège des deux serveurs",
  "en": "The box’s DHCP, and the two-server trap"
 },
 "summary": {
  "fr": "Les postes reçoivent leur adresse de la box par DHCP. Mais une vieille box est restée branchée : elle aussi distribue des adresses, et certains postes se retrouvent dans un autre réseau. Comprendre, trouver, réparer.",
  "en": "The computers get their address from the box by DHCP. But an old box was left plugged in: it hands out addresses too, and some computers end up in another network. Understand, find, fix."
 },
 "objectives": [
  {
   "fr": "Décrire les quatre messages du DHCP",
   "en": "Describe the four DHCP messages"
  },
  {
   "fr": "Reconnaître deux serveurs DHCP sur un même réseau",
   "en": "Recognise two DHCP servers on the same network"
  },
  {
   "fr": "Vérifier les baux et le ping",
   "en": "Check the leases and the ping"
  }
 ],
 "takeaways": [
  {
   "fr": "DHCP : DISCOVER (diffusion), OFFER, REQUEST, ACK. Le serveur donne adresse, masque, passerelle et DNS.",
   "en": "DHCP: DISCOVER (broadcast), OFFER, REQUEST, ACK. The server gives address, mask, gateway and DNS."
  },
  {
   "fr": "Deux serveurs sur un même réseau : chaque poste prend l’offre du premier qui répond (J1207).",
   "en": "Two servers on one network: each computer takes the offer of whichever answers first (J1207)."
  },
  {
   "fr": "Un seul serveur DHCP par réseau.",
   "en": "One DHCP server per network."
  }
 ],
