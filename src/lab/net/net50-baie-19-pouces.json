 "title": {
  "fr": "Concevoir une baie 19 pouces",
  "en": "Design a 19-inch rack"
 },
 "summary": {
  "fr": "Une baie de 22U attend son switch 48 ports, deux panneaux de brassage, leurs passe-câbles, un onduleur et une PDU. Quelqu’un a monté le switch et le premier panneau sur les mêmes U. Placez chaque équipement sans chevauchement, dans la charge de la baie, branchez l’énergie, puis brassez les quatre prises du bureau jusqu’au switch.",
  "en": "A 22U rack is waiting for its 48-port switch, two patch panels, their cable managers, a UPS and a PDU. Someone mounted the switch and the first panel on the same U. Place each device without overlap, within the rack load, connect the power, then patch the four office outlets through to the switch."
 },
 "objectives": [
  {
   "fr": "Lire une élévation de baie : U, faces avant et arrière, profondeur",
   "en": "Read a rack elevation: U, front and rear faces, depth"
  },
  {
   "fr": "Vérifier le poids, la PDU et l’autonomie de l’onduleur",
   "en": "Check the weight, the PDU and the UPS runtime"
  },
  {
   "fr": "Brasser des prises murales jusqu’au switch par le panneau",
   "en": "Patch wall outlets through the panel to the switch"
  }
 ],
 "takeaways": [
  {
   "fr": "1U = 44,45 mm ; une façade 19 pouces fait 482,6 mm (EIA-310).",
   "en": "1U = 44.45 mm; a 19-inch front panel is 482.6 mm wide (EIA-310)."
  },
  {
   "fr": "Un appareil plus profond que la moitié de la baie prend aussi la face arrière.",
   "en": "A device deeper than half the rack also takes the rear face."
  },
  {
   "fr": "Un passe-câbles 1U contre chaque panneau ; un obturateur dans chaque U libre.",
   "en": "A 1U cable manager next to each panel; a blanking panel in each free U."
  },
  {
   "fr": "Le panneau relie la prise (lien permanent, derrière) au switch (cordon court, devant).",
   "en": "The panel links the outlet (permanent link, at the back) to the switch (short cord, at the front)."
  }
 ],
