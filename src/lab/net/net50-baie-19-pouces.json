 "steps": [
  {
   "title": {
    "fr": "La baie",
    "en": "The rack"
   },
   "text": {
    "fr": "Ouvrez la vue **Baies** (Alt+3), puis **Élévation**. La baie fait **22U** : chaque U mesure **44,45 mm**. À gauche, la liste **Hors baie** ; on glisse un équipement dans un U libre, on le monte ou le descend avec les flèches.",
    "en": "Open the **Racks** view (Alt+3), then **Elevation**. The rack is **22U**: each U is **44.45 mm**. On the left, the **Unracked** list; drag a device into a free U, move it up or down with the arrow keys."
   },
   "spot": [
    ".ntViewBar [data-view=\"racks\"]"
   ],
   "check": {
    "type": "info"
   }
  },
  {
   "title": {
    "fr": "Combien de place ?",
    "en": "How much room?"
   },
   "text": {
    "fr": "Le switch, les deux panneaux et les deux passe-câbles font 1U chacun, l’onduleur 2U ; la PDU est verticale (0U). Combien d’U de façade occupent-ils ensemble ?",
    "en": "The switch, both panels and both cable managers are 1U each, the UPS is 2U; the PDU is vertical (0U). How many front U do they take together?"
   },
   "keep": {
    "fr": "5 × 1U + 2U = 7U : il reste 15U, à fermer par des obturateurs.",
    "en": "5 × 1U + 2U = 7U: 15U remain, to close with blanking panels."
   },
   "check": {
    "type": "quiz",
    "options": [
     {
      "fr": "6U",
      "en": "6U"
     },
     {
      "fr": "7U",
      "en": "7U"
     },
     {
      "fr": "8U",
      "en": "8U"
     },
     {
      "fr": "9U",
      "en": "9U"
     }
    ],
    "answer": 1
   }
  },
  {
   "title": {
    "fr": "Placer sans chevauchement",
    "en": "Place without overlap"
   },
   "text": {
    "fr": "Séparez le switch et le panneau PB1, puis rangez dans BAIE1 : PB1, un passe-câbles, le switch SW1, un passe-câbles, PB2 (de haut en bas, en haut de la baie), et l’onduleur en bas (il est lourd). Le switch est profond : il prend aussi la face arrière.",
    "en": "Separate the switch and panel PB1, then put into BAIE1: PB1, a cable manager, switch SW1, a cable manager, PB2 (top to bottom, at the top of the rack), and the UPS at the bottom (it is heavy). The switch is deep: it also takes the rear face."
   },
   "hint": {
    "fr": "Une collision est entourée de rouge. Choisissez un équipement et utilisez ↑ ↓ pour le déplacer d’un U.",
    "en": "A collision is outlined in red. Select a device and use ↑ ↓ to move it one U."
   },
   "check": {
    "type": "net-rack",
    "rack": "BAIE1",
    "require": [
     {
      "sel": "switch48"
     },
     {
      "sel": "patch24",
      "n": 2
     },
     {
      "sel": "cablemgr",
      "n": 2
     },
     {
      "sel": "ups"
     }
    ]
   }
  },
  {
   "title": {
    "fr": "L’énergie",
    "en": "Power"
   },
   "text": {
    "fr": "Glissez la PDU verticale dans la baie (elle se fixe à l’arrière, sans prendre d’U). L’onduleur doit tenir **10 min** au moins : regardez son autonomie dans l’inspecteur de la baie.",
    "en": "Drag the vertical PDU into the rack (it mounts at the rear, without taking a U). The UPS must last at least **10 min**: check its runtime in the rack inspector."
   },
   "check": {
    "type": "net-power",
    "rack": "BAIE1",
    "runtime": 10
   }
  },
  {
   "title": {
    "fr": "Le brassage",
    "en": "Patching"
   },
   "text": {
    "fr": "Les prises PR1 à PR4 arrivent derrière PB1 (ports 1 à 4). Ouvrez **Brassage** et reliez PB1 · 1 à 4 aux ports 1 à 4 de SW1 par des cordons de 0,5 m.",
    "en": "Outlets PR1 to PR4 arrive at the back of PB1 (ports 1 to 4). Open **Patching** and connect PB1 · 1 to 4 to ports 1 to 4 of SW1 with 0.5 m cords."
   },
   "spot": [
    "[data-rkpatch]"
   ],
   "check": {
    "type": "net-patching",
    "rack": "BAIE1",
    "n": 4
   }
  },
  {
   "title": {
    "fr": "Baie conforme",
    "en": "Compliant rack"
   },
   "text": {
    "fr": "Plus aucune collision, rien hors de la baie, charge et énergie dans les limites, un passe-câbles contre chaque panneau.",
    "en": "No more collisions, nothing outside the rack, load and power within limits, a cable manager next to each panel."
   },
   "check": {
    "type": "net-ok",
    "codes": [
     "J1273",
