{
 "id": "iot04-regles-mqtt-page",
 "series": "objets",
 "workspace": "elec",
 "level": "lycee",
 "minutes": 45,
 "title": {
  "fr": "Règles connectées : MQTT et page web sans écrire de code",
  "en": "Connected rules: MQTT and a web page without writing code"
 },
 "summary": {
  "fr": "Un Arduino Uno et un module W5500 rejoignent le réseau de l’atelier. Des règles, écrites en phrases, publient la position d’un potentiomètre sur le serveur MQTT, allument une lampe quand un message arrive, et montrent une page web. Le programme est généré à partir des règles, le même pour le simulateur et pour la vraie carte.",
  "en": "An Arduino Uno and a W5500 module join the workshop network. Rules, written as sentences, publish a potentiometer’s position to the MQTT server, switch a lamp on when a message arrives, and show a web page. The program is generated from the rules, the same for the simulator and the real board."
 },
 "objectives": [
  {
   "fr": "Publier une mesure sur un serveur MQTT avec une règle",
   "en": "Publish a reading to an MQTT server with a rule"
  },
  {
   "fr": "Commander une sortie par un message reçu (abonnement)",
   "en": "Drive an output from a received message (subscription)"
  },
  {
   "fr": "Montrer des valeurs sur la page web de la carte",
   "en": "Show values on the board’s web page"
  }
 ],
 "takeaways": [
  {
   "fr": "« Réseau » est une pièce des règles : il publie, il reçoit des messages et des demandes de page.",
   "en": "“Network” is a part of the rules: it publishes, receives messages and page requests."
  },
  {
   "fr": "Une règle « quand le message du sujet … vaut … » abonne la carte à ce sujet.",
   "en": "A rule “when the message on topic … is …” subscribes the board to that topic."
  },
  {
   "fr": "Le programme généré n’attend jamais le réseau : la carte reste réactive même sans serveur.",
   "en": "The generated program never waits for the network: the board stays responsive even without a server."
  }
 ],
