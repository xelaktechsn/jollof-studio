{
 "id": "net30-couverture-wifi-etage",
 "series": "reseau",
 "level": "pro",
 "minutes": 50,
 "title": {
  "fr": "Couverture Wi-Fi d’un étage",
  "en": "Wi-Fi coverage of a floor"
 },
 "summary": {
  "fr": "Au rez-de-chaussée du lycée, six salles de classe donnent sur un couloir aux murs en parpaing. Trois points d’accès ont été posés au bout du couloir, tous sur le même canal, et l’un ne s’allume même pas. Lire la carte de couverture, placer les points d’accès, choisir les canaux : toutes les salles doivent recevoir au moins -67 dBm, sans deux cellules sur le même canal.",
  "en": "On the ground floor of the high school, six classrooms open onto a corridor with concrete-block walls. Three access points were installed at the end of the corridor, all on the same channel, and one does not even power up. Read the coverage map, place the access points, choose the channels: every classroom must receive at least -67 dBm, with no two cells on the same channel."
 },
 "objectives": [
  {
   "fr": "Lire une carte de couverture Wi-Fi (signal, cellules, chevauchement)",
   "en": "Read a Wi-Fi coverage map (signal, cells, overlap)"
  },
  {
   "fr": "Placer des points d’accès pour couvrir des salles derrière des murs",
   "en": "Place access points to cover rooms behind walls"
  },
  {
   "fr": "Faire un plan de canaux sans recouvrement (1, 6, 11 à 2,4 GHz)",
   "en": "Make a channel plan without overlap (1, 6, 11 on 2.4 GHz)"
  }
 ],
 "takeaways": [
  {
   "fr": "Objectif de conception courant : -67 dBm en bordure de cellule (guides Cisco), avec 25 dB de rapport signal/bruit.",
   "en": "Common design goal: -67 dBm at the cell edge (Cisco guides), with a 25 dB signal-to-noise ratio."
  },
  {
   "fr": "Un mur en parpaing de 20 cm coûte environ 15 dB à 2,4 GHz et 25 dB à 5 GHz (UIT-R P.2040) : un point d’accès par zone de salles, pas tous au même endroit.",
   "en": "A 20 cm concrete-block wall costs about 15 dB at 2.4 GHz and 25 dB at 5 GHz (ITU-R P.2040): one access point per group of rooms, not all in one place."
  },
  {
   "fr": "À 2,4 GHz, seuls 1, 6 et 11 ne se chevauchent pas ; deux cellules voisines ne partagent jamais un canal (J1266).",
   "en": "On 2.4 GHz, only 1, 6 and 11 do not overlap; two neighbouring cells never share a channel (J1266)."
  },
  {
   "fr": "La carte est un modèle simplifié : une mesure sur place valide toujours la conception.",
   "en": "The map is a simplified model: an on-site survey always validates the design."
  }
 ],
