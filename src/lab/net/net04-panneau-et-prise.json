 "title": {
  "fr": "Panneau de brassage et prise murale",
  "en": "Patch panel and wall outlet"
 },
 "summary": {
  "fr": "Le câblage d’un bâtiment : du switch au panneau de brassage par un cordon, du panneau à la prise du bureau par le câble du mur, de la prise au PC par un autre cordon. 90 m au plus dans le mur, 100 m en tout : un bureau trop loin n’a plus un lien fiable.",
  "en": "A building’s cabling: from the switch to the patch panel by a patch cord, from the panel to the office outlet by the in-wall cable, from the outlet to the PC by another cord. 90 m at most in the wall, 100 m in total: an office too far away no longer has a reliable link."
 },
 "objectives": [
  {
   "fr": "Décrire un canal : cordon de brassage, lien permanent, cordon de poste",
   "en": "Describe a channel: patch cord, permanent link, work-area cord"
  },
  {
   "fr": "Appliquer les longueurs maximales (90 m et 100 m)",
   "en": "Apply the maximum lengths (90 m and 100 m)"
  },
  {
   "fr": "Relier un poste à sa prise murale",
   "en": "Connect a computer to its wall outlet"
  }
 ],
 "takeaways": [
  {
   "fr": "Lien permanent (panneau → prise) : 90 m au plus. Canal complet : 100 m au plus, cordons compris (10 m de cordons en tout).",
   "en": "Permanent link (panel → outlet): 90 m at most. Whole channel: 100 m at most, cords included (10 m of cords in total)."
  },
  {
   "fr": "Au-delà de 100 m, le lien perd des trames ou retombe à 100 Mb/s.",
   "en": "Beyond 100 m, the link loses frames or falls back to 100 Mb/s."
  },
  {
   "fr": "Le panneau et la prise sont passifs : broche n d’un côté vers broche n de l’autre.",
   "en": "The panel and the outlet are passive: pin n on one side to pin n on the other."
  }
 ],
