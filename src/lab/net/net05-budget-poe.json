{
 "id": "net05-budget-poe",
 "series": "cablage",
 "level": "lycee",
 "minutes": 30,
 "title": {
  "fr": "Le budget PoE d’un switch",
  "en": "A switch’s PoE budget"
 },
 "summary": {
  "fr": "Un switch PoE alimente les caméras, le point d’accès et le téléphone par leur câble réseau. Mais son budget est de 64 W : chaque appareil réserve la puissance de sa classe, et le dernier servi reste éteint. Calculer, trouver qui manque, et trouver une solution.",
  "en": "A PoE switch powers the cameras, the access point and the phone through their network cable. But its budget is 64 W: each device reserves the power of its class, and the last one served stays off. Compute, find who is missing, and find a fix."
 },
 "objectives": [
  {
   "fr": "Connaître les classes PoE et la puissance réservée par chacune",
   "en": "Know the PoE classes and the power each one reserves"
  },
  {
   "fr": "Calculer le budget PoE d’un switch",
   "en": "Compute a switch’s PoE budget"
  },
  {
   "fr": "Choisir une solution quand le budget est dépassé",
   "en": "Choose a fix when the budget is exceeded"
  }
 ],
 "takeaways": [
  {
   "fr": "Le switch réserve la puissance de la classe annoncée : 4 W en classe 1, 15,4 W en classe 3, 30 W en classe 4.",
   "en": "The switch reserves the power of the announced class: 4 W for class 1, 15.4 W for class 3, 30 W for class 4."
  },
  {
   "fr": "Budget dépassé : le dernier appareil servi n’est pas alimenté (J1212).",
   "en": "Budget exceeded: the last device served gets no power (J1212)."
  },
  {
   "fr": "Solutions : un bloc secteur pour un appareil, un switch au budget plus grand, ou un appareil d’une classe plus basse.",
   "en": "Fixes: a mains adapter for one device, a switch with a larger budget, or a device of a lower class."
  }
 ],
