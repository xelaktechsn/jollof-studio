    "prog": {
      "rules": [],
      "boards": {
        "nano_1": {
          "code": "// Radar de recul : plus l’obstacle est proche, plus le buzzer bipe vite.\nconst int TRIG = 7;\nconst int ECHO = 8;\nconst int BUZZER = 4; // base du transistor BC547, par 1 kohm\n\n// Distance en cm : impulsion de 10 microsecondes sur TRIG, puis durée de l’écho.\nfloat mesurerDistance() {\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG, LOW);\n  long duree = pulseIn(ECHO, HIGH, 30000); // 0 si aucun écho\n  return duree / 58.0;\n}\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n  pinMode(BUZZER, OUTPUT);\n}\n\nvoid loop() {\n  float cm = mesurerDistance();\n  Serial.print(\"Distance : \");\n  Serial.print(cm);\n  Serial.println(\" cm\");\n\n  if (cm == 0 || cm > 100) {\n    digitalWrite(BUZZER, LOW);   // rien de proche : silence\n    delay(200);\n  } else if (cm < 10) {\n    digitalWrite(BUZZER, HIGH);  // très proche : son continu\n    delay(200);\n  } else {\n    int pause = cm * 10;         // 10 cm : 100 ms ; 100 cm : 1 s\n    digitalWrite(BUZZER, HIGH);\n    delay(80);\n    digitalWrite(BUZZER, LOW);\n    delay(pause);\n  }\n}\n",
          "auto": false
        }
      },
      "states": {},
      "mem": {},
      "net": null
    },
