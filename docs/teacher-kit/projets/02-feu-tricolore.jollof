    "prog": {
      "rules": [],
      "boards": {
        "uno_1": {
          "code": "// Feu tricolore : vert 5 s, orange 2 s, rouge 5 s, puis on recommence.\nconst int ROUGE = 7;\nconst int ORANGE = 8;\nconst int VERT = 2;\n\nvoid setup() {\n  pinMode(ROUGE, OUTPUT);\n  pinMode(ORANGE, OUTPUT);\n  pinMode(VERT, OUTPUT);\n  Serial.begin(9600);\n}\n\n// Allume les feux demandés (HIGH) et éteint les autres (LOW).\nvoid feux(int r, int o, int v) {\n  digitalWrite(ROUGE, r);\n  digitalWrite(ORANGE, o);\n  digitalWrite(VERT, v);\n}\n\nvoid loop() {\n  feux(LOW, LOW, HIGH);\n  Serial.println(\"Vert : on passe\");\n  delay(5000);\n\n  feux(LOW, HIGH, LOW);\n  Serial.println(\"Orange : on ralentit\");\n  delay(2000);\n\n  feux(HIGH, LOW, LOW);\n  Serial.println(\"Rouge : on s'arrete\");\n  delay(5000);\n}\n",
          "auto": false
        }
      },
