    "netNames": {},
    "prog": {
      "rules": [],
      "boards": {
        "uno_1": {
          "code": "// Thermomètre : le DHT22 mesure, l’écran LCD affiche.\n#include <DHT.h>\n#include <Wire.h>\n#include <LiquidCrystal_I2C.h>\n\nconst int BROCHE_DHT = 7;\nDHT dht(BROCHE_DHT, DHT22);\nLiquidCrystal_I2C lcd(0x27, 16, 2); // adresse I2C 0x27, 16 colonnes, 2 lignes\n\nvoid setup() {\n  Serial.begin(9600);\n  dht.begin();\n  lcd.init();\n  lcd.backlight();\n  lcd.print(\"Thermometre\");\n  delay(1000);\n  lcd.clear();\n}\n\nvoid loop() {\n  float t = dht.readTemperature(); // en degres Celsius\n  float h = dht.readHumidity();    // en %\n\n  if (isnan(t) || isnan(h)) {      // capteur absent ou mal cable\n    lcd.setCursor(0, 0);\n    lcd.print(\"Erreur capteur  \");\n    delay(2000);\n    return;\n  }\n\n  lcd.setCursor(0, 0);\n  lcd.print(\"Temp : \");\n  lcd.print(t, 1);\n  lcd.print(\" C   \");\n  lcd.setCursor(0, 1);\n  lcd.print(\"Hum  : \");\n  lcd.print(h, 0);\n  lcd.print(\" %   \");\n\n  Serial.print(\"Temperature : \");\n  Serial.print(t);\n  Serial.print(\" C, humidite : \");\n  Serial.print(h);\n  Serial.println(\" %\");\n\n  delay(2000); // le DHT22 ne donne pas plus d'une mesure toutes les 2 s\n}\n",
          "auto": false
        }
      },
      "states": {},
      "mem": {},
      "net": null
    },
