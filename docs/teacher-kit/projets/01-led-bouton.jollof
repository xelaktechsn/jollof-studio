    "prog": {
      "rules": [],
      "boards": {
        "uno_1": {
          "code": "// LED et bouton : la LED s’allume tant que le bouton est appuyé.\nconst int LED = 7;      // anode de la LED, par la résistance de 220 ohms\nconst int BOUTON = 2;   // une patte du bouton ; l’autre est à la masse\n\nvoid setup() {\n  pinMode(LED, OUTPUT);\n  pinMode(BOUTON, INPUT_PULLUP); // relâché : HIGH ; appuyé : LOW\n  Serial.begin(9600);\n  Serial.println(\"Appuyez sur le bouton\");\n}\n\nvoid loop() {\n  if (digitalRead(BOUTON) == LOW) {\n    digitalWrite(LED, HIGH);\n  } else {\n    digitalWrite(LED, LOW);\n  }\n}\n",
          "auto": false
        }
      },
      "states": {},
      "mem": {},
      "net": null
    },
