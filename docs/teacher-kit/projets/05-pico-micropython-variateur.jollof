      "boards": {
        "pico_1": {
          "engine": "micropython",
          "files": {
            "main.py": "# Variateur : le potentiomètre règle la luminosité de la LED.\nfrom machine import Pin, ADC, PWM\nimport time\n\npot = ADC(Pin(28))      # curseur du potentiomètre (entrée analogique)\nled = PWM(Pin(2))       # LED, par sa résistance de 220 ohms\nled.freq(1000)            # 1000 impulsions par seconde\n\nwhile True:\n    valeur = pot.read_u16()                 # de 0 à 65535\n    rapport = valeur * valeur // 65535      # courbe : plus fin dans les faibles lumières\n    led.duty_u16(rapport)\n    print(\"potentiometre :\", valeur * 100 // 65535, \"%  LED :\", rapport * 100 // 65535, \"%\")\n    time.sleep(0.2)\n"
          },
          "file": "main.py",
          "code": "",
          "auto": false
        }
      },
      "states": {},
      "mem": {},
      "net": null
    },
