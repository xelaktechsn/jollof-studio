 "settings": {
  "dur": 1.2,
  "env": {},
  "prog": {
   "rules": [
    {
     "kind": "rule",
     "id": "rb2stop",
     "src": {
      "comp": "cylsensor_8p35kn",
      "sig": "pressed"
     },
     "op": "==",
     "v": 1,
     "from": [
      0,
      100
     ],
     "then": [
      {
       "kind": "act",
       "id": "ab2off",
       "comp": "coil24_32luck",
       "act": "off",
       "arg": null
      }
     ],
     "else": [
      {
       "kind": "rule",
       "id": "rbtn",
       "src": {
        "comp": "button_y3hcts",
        "sig": "pressed"
       },
       "op": "==",
       "v": 1,
       "from": [
        0,
        100
       ],
       "then": [
        {
         "kind": "rule",
         "id": "rb1",
         "src": {
          "comp": "cylsensor_rhvsro",
          "sig": "pressed"
         },
         "op": "==",
         "v": 1,
         "from": [
          0,
          100
         ],
         "then": [
          {
           "kind": "act",
           "id": "ay1on",
           "comp": "coil24_32luck",
           "act": "on",
           "arg": null
          }
         ],
         "else": []
        }
       ],
       "else": []
      }
     ]
    }
   ],
   "boards": {
    "uno_fiwkj4": {
     "code": "// Programme de UNO (Arduino Uno), généré par Jollof Studio à partir des règles.\n// Vous pouvez le modifier librement : il ne sera plus régénéré.\n\nconst int B2 = 8;\nconst int Q1 = 2;\nconst int BTN1 = 7;\nconst int B1 = 3;\n\nunsigned long dernierAffichage = 0;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(B2, INPUT_PULLUP); // piston absent : HIGH, piston devant le capteur : LOW\n  pinMode(Q1, OUTPUT); // base de Q1 : HIGH, le transistor conduit et Y1 est excitée\n  pinMode(BTN1, INPUT_PULLUP); // relâché : HIGH, appuyé : LOW\n  pinMode(B1, INPUT_PULLUP); // piston absent : HIGH, piston devant le capteur : LOW\n}\n\nvoid loop() {\n  // Mesures\n  bool b2_piston = digitalRead(B2) == LOW;\n  bool btn1_appuye = digitalRead(BTN1) == LOW;\n  bool b1_piston = digitalRead(B1) == LOW;\n\n  // Règle 1 : Quand B2 détecte le piston : Y1 est coupée ; sinon [Quand BTN1 est appuyé : [Quand B1 détecte le piston : Y1 est excitée]].\n  if (b2_piston) {\n    digitalWrite(Q1, LOW);\n  } else if (btn1_appuye) { // Règle 1.1\n    // Règle 1.1.1 : Quand B1 détecte le piston : Y1 est excitée.\n    if (b1_piston) {\n      digitalWrite(Q1, HIGH);\n    }\n  }\n\n  // Mesures sur le moniteur série, une fois par seconde\n  if (millis() - dernierAffichage >= 1000) {\n    dernierAffichage = millis();\n    Serial.print(F(\"B2 détecte le piston : \"));\n    Serial.print(b2_piston ? \"oui\" : \"non\");\n    Serial.print(F(\" | \"));\n    Serial.print(F(\"BTN1 est appuyé : \"));\n    Serial.print(btn1_appuye ? \"oui\" : \"non\");\n    Serial.print(F(\" | \"));\n    Serial.print(F(\"B1 détecte le piston : \"));\n    Serial.println(b1_piston ? \"oui\" : \"non\");\n  }\n  delay(10); // une centaine de tours par seconde : assez pour réagir, sans calcul inutile\n}\n",
     "auto": true
    }
   },
   "states": {},
   "mem": {},
   "net": null
  },
  "modules": {
   "pneu": {
    "circuit": {
     "elements": [
      {
       "id": "src",
       "type": "supply",
       "x": 11,
       "y": 24,
       "p": {}
      },
      {
       "id": "v1",
       "type": "v52",
       "x": 0,
       "y": 14,
       "p": {
        "left": "sol",
        "right": "spring",
        "coilL": "Y1"
       }
      },
      {
       "id": "fc",
       "type": "flowctl",
       "x": 20,
       "y": 5,
       "p": {
        "open": 60
       }
      },
      {
       "id": "c1",
       "type": "cyl2",
       "x": 0,
       "y": 0,
       "p": {
        "time": 1,
        "s0": "B1",
        "s1": "B2",
        "label": "1A"
       }
      }
     ],
     "tubes": [
      {
       "id": "t1",
       "a": [
        "src",
        "1"
       ],
       "b": [
        "v1",
        "1"
       ]
      },
      {
       "id": "t2",
       "a": [
        "v1",
        "4"
       ],
       "b": [
        "c1",
        "1"
       ]
      },
      {
       "id": "t3",
       "a": [
        "v1",
        "2"
       ],
       "b": [
        "fc",
        "1"
       ]
      },
      {
       "id": "t4",
       "a": [
        "fc",
        "2"
       ],
       "b": [
        "c1",
        "2"
       ]
      }
     ]
    }
   }
  }
 }
