{
 "app": "jollof-studio",
 "version": 1,
 "name": "Réseau de la salle informatique",
 "description": "Le réseau d’une salle de classe : box (DHCP), switch PoE dans la baie, panneau de brassage, cinq prises murales, deux PC, une imprimante à adresse fixe, un point d’accès Wi-Fi et une caméra alimentés par PoE, un portable en Wi-Fi. Liens permanents de 42 à 63 m, cordons de 1 et 3 m.",
 "en": {
  "name": "Computer room network",
  "description": "A classroom network: box (DHCP), PoE switch in the rack, patch panel, five wall outlets, two PCs, a printer with a fixed address, a Wi-Fi access point and a camera powered by PoE, a laptop on Wi-Fi. Permanent links from 42 to 63 m, 1 m and 3 m cords."
 },
