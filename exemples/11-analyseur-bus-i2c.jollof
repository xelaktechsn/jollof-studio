 "settings": {
  "dur": 1.2,
  "env": {
   "temp": 24,
   "hum": 55,
   "press": 1013,
   "lux": 300,
   "dist": 50,
   "motion": 0,
   "soil": 40,
   "gas": 0,
   "sound": 45,
   "tilt": 0
  },
  "prog": {
   "rules": [],
   "boards": {
    "pico_1": {
     "auto": false,
     "code": "// Scanner I2C, puis lecture du BMP280 : ouvrez le banc de mesure, onglet « Analyseur de bus ».\n#include <Wire.h>\n#include <Adafruit_BMP280.h>\nAdafruit_BMP280 bmp;\n\nvoid setup() {\n  Serial.begin(9600);\n  while (!Serial) delay(10); // Pico : Serial passe par l’USB\n  Wire.begin();\n  Serial.println(\"Balayage du bus I2C...\");\n  for (byte a = 1; a < 127; a++) {\n    Wire.beginTransmission(a);\n    if (Wire.endTransmission() == 0) { Serial.print(\"Module en 0x\"); Serial.println(a, HEX); }\n  }\n  if (!bmp.begin(0x76)) Serial.println(\"BMP280 introuvable en 0x76\");\n}\n\nvoid loop() {\n  Serial.print(\"Temperature : \");\n  Serial.print(bmp.readTemperature());\n  Serial.println(\" C\");\n  delay(1000);\n}"
    }
   },
   "states": {}
  }
 }
}
