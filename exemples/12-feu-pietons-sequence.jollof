{
 "app": "jollof-studio",
 "version": 1,
 "name": "Feu piétons (séquence)",
 "description": "Une séquence de trois étapes (vert, orange, rouge) sans un seul delay() : le bouton d’appel « dès que » mémorise la demande dans une variable, le vert dure au moins 2 s, le rouge fait biper le buzzer pendant 4 s puis compte les passages.",
 "en": {
  "name": "Pedestrian crossing (sequence)",
  "description": "A three-step sequence (green, amber, red) without a single delay(): the call button (\"as soon as\") stores the request in a variable, green lasts at least 2 s, red beeps the buzzer for 4 s and counts the crossings."
 },
