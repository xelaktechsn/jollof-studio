  "prog": {
   "rules": [
    {
     "kind": "var",
     "id": "v1",
     "name": "appel",
     "type": "bool",
     "init": false,
     "persist": false
    },
    {
     "kind": "var",
     "id": "v2",
     "name": "passages",
     "type": "int",
     "init": 0,
     "persist": false
    },
    {
     "kind": "seq",
     "id": "qj",
     "name": "Feu",
     "steps": [
      {
       "kind": "step",
       "id": "e3",
       "name": "Vert",
       "do": [
        {
         "kind": "act",
         "id": "a6",
         "comp": "traffic_1",
         "act": "green",
         "arg": null
        },
        {
         "kind": "act",
         "id": "a7",
         "comp": "@serial",
         "act": "print",
         "arg": "Feu vert pour les voitures"
        }
       ],
       "go": [
        {
         "kind": "go",
         "id": "t8",
         "after": 2000,
         "when": {
          "src": {
           "var": "v1"
          },
          "op": "==",
          "v": 1
         },
         "to": "e4"
        }
       ]
      },
      {
       "kind": "step",
       "id": "e4",
       "name": "Orange",
       "do": [
        {
         "kind": "act",
         "id": "a9",
         "comp": "traffic_1",
         "act": "yellow",
         "arg": null
        }
       ],
       "go": [
        {
         "kind": "go",
         "id": "ta",
         "after": 1500,
         "when": null,
         "to": "e5"
        }
       ]
      },
      {
       "kind": "step",
       "id": "e5",
       "name": "Rouge",
       "do": [
        {
         "kind": "act",
         "id": "ab",
         "comp": "traffic_1",
         "act": "red",
         "arg": null
        },
        {
         "kind": "set",
         "id": "sc",
         "var": "v1",
         "op": "=",
         "v": false
        },
        {
         "kind": "set",
         "id": "sd",
         "var": "v2",
         "op": "+",
         "v": 1
        },
        {
         "kind": "act",
         "id": "ae",
         "comp": "buzzer_3",
         "act": "beep",
         "arg": 250
        },
        {
         "kind": "wait",
         "id": "wf",
         "ms": 4000
        },
        {
         "kind": "act",
         "id": "ag",
         "comp": "buzzer_3",
         "act": "off",
         "arg": null
        },
        {
         "kind": "act",
         "id": "ah",
         "comp": "@serial",
         "act": "show",
         "arg": null,
         "what": {
          "var": "v2"
         }
        }
       ],
       "go": [
        {
         "kind": "go",
         "id": "ti",
         "after": 5000,
         "when": null,
         "to": "e3"
        }
       ]
      }
     ],
     "start": "boot"
    },
    {
     "kind": "rule",
     "id": "rm",
     "src": {
      "comp": "button_2",
      "sig": "pressed"
     },
     "op": "==",
     "v": 1,
     "from": [
      0,
      100
     ],
