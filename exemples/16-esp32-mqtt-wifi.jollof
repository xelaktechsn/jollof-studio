 "settings": {
  "kind": "iot",
  "dur": 1.2,
  "env": {
   "temp": 24,
   "hum": 55,
   "press": 1013,
   "lux": 300,
   "dist": 35,
   "motion": 0,
   "soil": 40,
   "gas": 0,
   "sound": 45,
   "tilt": 0
  },
  "prog": {
   "rules": [],
   "boards": {
    "esp32_0": {
     "code": "// ESP32 en Wi-Fi : publie la position du potentiomètre sur atelier/pot, allume la LED selon atelier/led.\n#include <WiFi.h>\n#include <PubSubClient.h>\n\nconst char* ssid = \"Atelier\";\nconst char* motDePasse = \"jollof2024\";\nIPAddress broker(192, 168, 1, 10);   // le Serveur MQTT du plan réseau\nconst int POT = 32;\nconst int LED = 14;\n\nWiFiClient wifi;\nPubSubClient mqtt(wifi);\nunsigned long dernier = 0;\n\nvoid recu(char* sujet, byte* message, unsigned int longueur) {\n  if (longueur > 0 && message[0] == '1') digitalWrite(LED, HIGH);\n  else digitalWrite(LED, LOW);\n}\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LED, OUTPUT);\n  WiFi.begin(ssid, motDePasse);\n  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print(\".\"); }\n  Serial.println();\n  Serial.println(WiFi.localIP());\n  mqtt.setServer(broker, 1883);\n  mqtt.setCallback(recu);\n}\n\nvoid loop() {\n  if (!mqtt.connected()) {\n    if (mqtt.connect(\"esp32-atelier\")) mqtt.subscribe(\"atelier/led\");\n    else { delay(2000); return; }\n  }\n  mqtt.loop();\n  if (millis() - dernier > 2000) {\n    dernier = millis();\n    mqtt.publish(\"atelier/pot\", String(analogRead(POT)).c_str());\n  }\n}\n",
     "auto": false
    }
   }
  },
  "modules": {
