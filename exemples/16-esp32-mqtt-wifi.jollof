{
 "app": "jollof-studio",
 "version": 1,
 "name": "ESP32 MQTT en Wi-Fi",
 "description": "ESP32 avec un potentiomètre (GPIO32) et une LED (GPIO14). Plan réseau : box, switch PoE, point d’accès « Atelier » alimenté par PoE, Serveur MQTT et PC. L’ESP32 rejoint le Wi-Fi, publie la position du potentiomètre sur atelier/pot toutes les 2 s et allume la LED quand « 1 » arrive sur atelier/led (publiez-le depuis le panneau de MQTT1).",
 "en": {
  "name": "ESP32 MQTT over Wi-Fi",
  "description": "ESP32 with a potentiometer (GPIO32) and an LED (GPIO14). Network plan: box, PoE switch, PoE-powered “Atelier” access point, MQTT Server and PC. The ESP32 joins the Wi-Fi, publishes the potentiometer’s position on atelier/pot every 2 s and lights the LED when “1” arrives on atelier/led (publish it from MQTT1’s panel).",
  "code": {
   "esp32_0": [
    "// ESP32 on Wi-Fi: publishes the potentiometer position on atelier/pot, drives the LED from atelier/led.",
    "#include <WiFi.h>",
    "#include <PubSubClient.h>",
    "",
    "const char* ssid = \"Atelier\";",
    "const char* motDePasse = \"jollof2024\";",
    "IPAddress broker(192, 168, 1, 10);   // the network plan’s MQTT Server",
    "const int POT = 32;",
    "const int LED = 14;",
    "",
    "WiFiClient wifi;",
    "PubSubClient mqtt(wifi);",
    "unsigned long dernier = 0;",
    "",
    "void recu(char* sujet, byte* message, unsigned int longueur) {",
    "  if (longueur > 0 && message[0] == '1') digitalWrite(LED, HIGH);",
    "  else digitalWrite(LED, LOW);",
    "}",
    "",
    "void setup() {",
    "  Serial.begin(115200);",
    "  pinMode(LED, OUTPUT);",
    "  WiFi.begin(ssid, motDePasse);",
    "  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print(\".\"); }",
    "  Serial.println();",
    "  Serial.println(WiFi.localIP());",
    "  mqtt.setServer(broker, 1883);",
    "  mqtt.setCallback(recu);",
    "}",
    "",
    "void loop() {",
    "  if (!mqtt.connected()) {",
    "    if (mqtt.connect(\"esp32-atelier\")) mqtt.subscribe(\"atelier/led\");",
    "    else { delay(2000); return; }",
    "  }",
    "  mqtt.loop();",
    "  if (millis() - dernier > 2000) {",
    "    dernier = millis();",
    "    mqtt.publish(\"atelier/pot\", String(analogRead(POT)).c_str());",
    "  }",
    "}"
   ]
  }
 },
