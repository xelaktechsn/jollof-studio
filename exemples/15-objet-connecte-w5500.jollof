{
 "app": "jollof-studio",
 "version": 1,
 "name": "Objet connecté W5500",
 "description": "Arduino Uno et module Ethernet W5500 (SPI : D10 CS, D11 MOSI, D12 MISO, D13 SCK), alimenté en 3,3 V par un régulateur AMS1117 (la broche 3V3 de l’Uno ne donne que 50 mA), et un potentiomètre sur A0. Plan réseau : box, switch, PC et Serveur MQTT. Le programme prend une adresse par DHCP, sert une page web avec la position du potentiomètre (navigateur de PC1 : http://ETH1/) et la publie sur atelier/pot toutes les 2 s.",
 "en": {
  "name": "W5500 connected object",
  "description": "Arduino Uno and W5500 Ethernet module (SPI: D10 CS, D11 MOSI, D12 MISO, D13 SCK), powered at 3.3 V by an AMS1117 regulator (the Uno’s 3V3 pin only gives 50 mA), and a potentiometer on A0. Network plan: box, switch, PC and MQTT Server. The program gets an address by DHCP, serves a web page with the potentiometer’s position (PC1’s browser: http://ETH1/) and publishes it on atelier/pot every 2 s.",
  "code": {
   "uno_0": [
    "// Connected object: Uno + W5500. Web page (potentiometer position) and MQTT publication every 2 s.",
    "#include <SPI.h>",
    "#include <Ethernet.h>",
    "#include <PubSubClient.h>",
    "",
    "byte mac[] = { 0xDE, 0xAD, 0xBE, 0xEF, 0xFE, 0xED };",
    "IPAddress broker(192, 168, 1, 10);   // MQTT Server of the network plan",
    "EthernetServer serveur(80);",
    "EthernetClient ethClient;",
    "PubSubClient mqtt(ethClient);",
    "unsigned long dernier = 0;",
    "",
    "void page() {",
    "  EthernetClient client = serveur.available();",
    "  if (!client) return;",
    "  boolean ligneVide = true;",
    "  while (client.connected()) {",
    "    if (client.available()) {",
    "      char c = client.read();",
    "      if (c == '\\n' && ligneVide) {",
    "        client.println(\"HTTP/1.1 200 OK\");",
    "        client.println(\"Content-Type: text/html; charset=utf-8\");",
    "        client.println(\"Connection: close\");",
    "        client.println();",
    "        client.print(\"<h1>Atelier</h1><p>Potentiometre : \");",
    "        client.print(analogRead(A0));",
    "        client.println(\"</p>\");",
    "        break;",
    "      }",
    "      if (c == '\\n') ligneVide = true;",
    "      else if (c != '\\r') ligneVide = false;",
    "    }",
    "  }",
    "  delay(1);",
    "  client.stop();",
    "}",
    "",
    "void setup() {",
    "  Serial.begin(9600);",
    "  Ethernet.init(10);",
    "  if (Ethernet.begin(mac) == 0) { Serial.println(\"Pas de serveur DHCP\"); while (true) delay(1); }",
    "  serveur.begin();",
    "  mqtt.setServer(broker, 1883);",
    "  Serial.print(\"Page web : http://\");",
    "  Serial.println(Ethernet.localIP());",
    "}",
    "",
    "void loop() {",
    "  page();",
    "  if (!mqtt.connected()) {",
    "    if (!mqtt.connect(\"uno-atelier\")) { delay(2000); return; }",
    "    Serial.println(\"MQTT connecte\");",
    "  }",
    "  mqtt.loop();",
    "  if (millis() - dernier > 2000) {",
    "    dernier = millis();",
    "    mqtt.publish(\"atelier/pot\", String(analogRead(A0)).c_str());",
    "  }",
    "}"
   ]
  }
 },
