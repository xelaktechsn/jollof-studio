   "boards": {
    "uno_1": {
     "code": "// Radar de recul : plus l’obstacle est proche, plus le buzzer bipe vite.\n// L’écran affiche la distance et une barre de proximité.\n#include <Wire.h>\n#include <LiquidCrystal_I2C.h>\n\nconst int TRIG = 7;\nconst int ECHO = 8;\nconst int BUZZER = 2;\nLiquidCrystal_I2C lcd(0x27, 16, 2);\n\n// Distance en cm : impulsion de 10 µs sur TRIG, puis durée de l’écho.\nfloat mesurerDistance() {\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG, LOW);\n  long duree = pulseIn(ECHO, HIGH, 30000); // 0 si aucun écho\n  return duree / 58.0;\n}\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n  pinMode(BUZZER, OUTPUT);\n  lcd.init();\n  lcd.backlight();\n  lcd.print(\"Radar de recul\");\n  delay(1000);\n}\n\nvoid loop() {\n  float cm = mesurerDistance();\n\n  lcd.setCursor(0, 0);\n  lcd.print(\"Distance:       \");\n  lcd.setCursor(10, 0);\n  if (cm == 0) {\n    lcd.print(\"---\");\n  } else {\n    lcd.print(cm, 0);\n    lcd.print(\" cm\");\n  }\n\n  // Barre : un bloc de plus par tranche de 10 cm en dessous de 160 cm.\n  int blocs = cm == 0 ? 0 : constrain(16 - (int)(cm / 10), 0, 16);\n  lcd.setCursor(0, 1);\n  for (int i = 0; i < 16; i++) {\n    lcd.print(i < blocs ? '#' : ' ');\n  }\n\n  Serial.print(\"Distance : \");\n  Serial.print(cm);\n  Serial.println(\" cm\");\n\n  if (cm > 0 && cm < 10) {\n    digitalWrite(BUZZER, HIGH); // très près : son continu\n    delay(100);\n  } else if (cm > 0 && cm < 100) {\n    digitalWrite(BUZZER, HIGH);\n    delay(50);\n    digitalWrite(BUZZER, LOW);\n    delay(cm * 4); // plus l’obstacle est loin, plus la pause est longue\n  } else {\n    digitalWrite(BUZZER, LOW);\n    delay(200);\n  }\n}\n",
     "auto": false
    }
   }
  }
 }
