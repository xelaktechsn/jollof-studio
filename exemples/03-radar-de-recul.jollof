{
 "app": "jollof-studio",
 "version": 1,
 "name": "Radar de recul",
 "description": "Arduino Uno, un télémètre à ultrasons HC-SR04, un buzzer derrière un transistor BC547 (il tire 25 mA, plus que les 20 mA conseillés par broche) qui bipe plus vite quand l’obstacle approche et un écran LCD 16×2 pour la distance. Tout est en 5 V : aucun adaptateur de niveau nécessaire. Programme écrit à la main : le buzzer bipe de plus en plus vite quand l’obstacle approche.",
 "en": {
  "name": "Parking radar",
  "description": "Arduino Uno, an HC-SR04 ultrasonic range finder, a buzzer behind a BC547 transistor (it draws 25 mA, more than the 20 mA advised per pin) that beeps faster as the obstacle gets closer and a 16×2 LCD for the distance. Everything runs on 5 V: no level shifter needed. Hand-written program: the buzzer beeps faster and faster as the obstacle approaches.",
  "code": {
   "uno_1": [
    "// Parking radar: the closer the obstacle, the faster the buzzer beeps.",
    "// The display shows the distance and a proximity bar.",
    "#include <Wire.h>",
    "#include <LiquidCrystal_I2C.h>",
    "",
    "const int TRIG = 7;",
    "const int ECHO = 8;",
    "const int BUZZER = 2;",
    "LiquidCrystal_I2C lcd(0x27, 16, 2);",
    "",
    "// Distance in cm: 10 µs pulse on TRIG, then length of the echo.",
    "float measureDistance() {",
    "  digitalWrite(TRIG, LOW);",
    "  delayMicroseconds(2);",
    "  digitalWrite(TRIG, HIGH);",
    "  delayMicroseconds(10);",
    "  digitalWrite(TRIG, LOW);",
    "  long duration = pulseIn(ECHO, HIGH, 30000); // 0 if no echo",
    "  return duration / 58.0;",
    "}",
    "",
    "void setup() {",
    "  Serial.begin(9600);",
    "  pinMode(TRIG, OUTPUT);",
    "  pinMode(ECHO, INPUT);",
    "  pinMode(BUZZER, OUTPUT);",
    "  lcd.init();",
    "  lcd.backlight();",
    "  lcd.print(\"Parking radar\");",
    "  delay(1000);",
    "}",
    "",
    "void loop() {",
    "  float cm = measureDistance();",
    "",
    "  lcd.setCursor(0, 0);",
    "  lcd.print(\"Distance:       \");",
    "  lcd.setCursor(10, 0);",
    "  if (cm == 0) {",
    "    lcd.print(\"---\");",
    "  } else {",
    "    lcd.print(cm, 0);",
    "    lcd.print(\" cm\");",
    "  }",
    "",
    "  // Bar: one more block for every 10 cm below 160 cm.",
    "  int blocks = cm == 0 ? 0 : constrain(16 - (int)(cm / 10), 0, 16);",
    "  lcd.setCursor(0, 1);",
    "  for (int i = 0; i < 16; i++) {",
    "    lcd.print(i < blocks ? '#' : ' ');",
    "  }",
    "",
    "  Serial.print(\"Distance: \");",
    "  Serial.print(cm);",
    "  Serial.println(\" cm\");",
    "",
    "  if (cm > 0 && cm < 10) {",
    "    digitalWrite(BUZZER, HIGH); // very close: continuous tone",
    "    delay(100);",
    "  } else if (cm > 0 && cm < 100) {",
    "    digitalWrite(BUZZER, HIGH);",
    "    delay(50);",
    "    digitalWrite(BUZZER, LOW);",
    "    delay(cm * 4); // the farther the obstacle, the longer the pause",
    "  } else {",
    "    digitalWrite(BUZZER, LOW);",
    "    delay(200);",
    "  }",
    "}"
   ]
  }
 },
