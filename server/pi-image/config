# Configuration pi-gen (https://github.com/RPi-Distro/pi-gen, branche arm64) de l'image du boîtier
# école : Raspberry Pi OS Lite 64 bits + Docker + serveur Jollof Studio. Lue par build.sh, qui la
# copie dans pi-gen ; chaque variable est décrite dans le README de pi-gen.
# Fragment lu par pi-gen (source) : ses variables y servent.
# shellcheck disable=SC2034

IMG_NAME='jollof-ecole'
PI_GEN_RELEASE='Jollof Studio, boîtier école'
RELEASE='trixie'
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL=6

# Lite (stages 0 à 2), puis l'étape Jollof. stage2 n'exporte pas sa propre image (build.sh).
STAGE_LIST='stage0 stage1 stage2 stage-jollof'

TARGET_HOSTNAME='jollof-ecole'
LOCALE_DEFAULT='fr_FR.UTF-8'
KEYBOARD_KEYMAP='fr'
KEYBOARD_LAYOUT='French'
TIMEZONE_DEFAULT='Africa/Dakar'
WPA_COUNTRY='SN'

# Aucun mot de passe par défaut dans l'image : le compte système se choisit à la gravure (Raspberry
# Pi Imager, « Personnaliser », par cloud-init) ou, à défaut, à l'assistant du premier démarrage
# (écran et clavier). FIRST_USER_PASS non défini = compte verrouillé jusque-là.
FIRST_USER_NAME='pi'
DISABLE_FIRST_BOOT_USER_RENAME=0
# SSH fermé par défaut ; Raspberry Pi Imager peut l'ouvrir à la gravure (avec le compte choisi).
ENABLE_SSH=0
# cloud-init : la personnalisation de Raspberry Pi Imager (nom, compte, Wi-Fi, SSH) s'applique.
ENABLE_CLOUD_INIT=1
