# Copier en .env puis adapter. docker compose lit aussi ce fichier (secrets, COMPOSE_FILE…).
# En production (NODE_ENV=production), l'API refuse de démarrer avec les valeurs d'exemple
# ci-dessous (JWT_SECRET, mot de passe de la base) : générez les vôtres.

# Fichiers compose utilisés par « docker compose » (séparés par « : ») :
#   cloud (défaut)    : docker-compose.yml
#   boîtier école     : docker-compose.box.yml
#   développement     : docker-compose.yml:docker-compose.dev.yml (base exposée sur le port 5433)
# COMPOSE_FILE=docker-compose.box.yml

# Mot de passe de PostgreSQL, à choisir AVANT la première création du volume (openssl rand -hex 24 :
# des chiffres hexadécimaux, sans caractère à échapper dans une URL). Développement : jollof.
POSTGRES_PASSWORD=

# Base PostgreSQL de l'API lancée hors Docker (npm run start:dev) ; docker compose construit la sienne.
DATABASE_URL=postgres://jollof:jollof@localhost:5433/jollof
# false | true (certificat vérifié) | no-verify (base gérée à certificat auto-signé)
DATABASE_SSL=false
# Connexions à la base (10 ; 5 sur un petit boîtier)
DB_POOL_SIZE=10

# Secret de signature des jetons d'accès : au moins 32 caractères aléatoires.
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Clé de l'exploitant pour POST /platform/schools/:id/plan (vide : route désactivée ; sinon 24 caractères au moins)
PLATFORM_KEY=

PORT=3100
TRIAL_DAYS=30

# Coût bcrypt (12 ; 11 sur un Raspberry Pi), workers bcrypt (défaut : cœurs - 1, 4 au plus),
# connexions par minute et par IP
BCRYPT_COST=12
# BCRYPT_WORKERS=2
LOGIN_RATE_LIMIT=10

# Proxy inverse (nginx, Caddy…) devant l'API : 1 (un proxy), un nombre de sauts ou une liste d'IP.
# false sans proxy : X-Forwarded-For est alors ignoré (un client pourrait le falsifier).
TRUST_PROXY=false

# Docker : adresse d'écoute de l'API sur l'hôte (127.0.0.1 en cloud derrière le proxy ; 0.0.0.0
# sur le boîtier), image à utiliser, tas JavaScript en Mo (384 en cloud, 192 sur le boîtier)
# API_BIND=127.0.0.1
# JOLLOF_IMAGE=jollof-api
# API_HEAP_MB=384
